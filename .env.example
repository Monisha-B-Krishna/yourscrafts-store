# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Leave the Supabase values empty to run the site in "demo mode" with example products.

# The site's own address (http://localhost:3000 on your laptop; the vercel.app URL in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API (or `npx supabase status` for the local copy)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses Row Level Security — never expose it in the browser.
# Used for analytics events now (and orders/stock from Phase 4). Without it, analytics is off.
SUPABASE_SERVICE_ROLE_KEY=

# The owner's login email. When this account signs in with a CONFIRMED email, it becomes
# the admin (opens /admin). Needs SUPABASE_SERVICE_ROLE_KEY. See docs/setup.md section 4.
ADMIN_EMAIL=

# --- Added in later phases ---
# Razorpay (Phase 4, test mode keys start with rzp_test_)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Resend emails (Phase 5, optional — the store works without it)
# RESEND_API_KEY=
# EMAIL_FROM=
