# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Leave the Supabase values empty to run the site in "demo mode" with example products.

# The site's own address (http://localhost:3000 on your laptop; the vercel.app URL in production).
# Used for links in emails, Google's sitemap and share previews. On Vercel it falls back to the
# project's main address if left empty, but setting it is clearer.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API (or `npx supabase status` for the local copy)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses Row Level Security — never expose it in the browser.
# Used for analytics events now (and orders/stock from Phase 4). Without it, analytics is off.
SUPABASE_SERVICE_ROLE_KEY=

# The owner's login email. When this account signs in with a CONFIRMED email, it becomes
# the admin (opens /admin). Needs SUPABASE_SERVICE_ROLE_KEY. See docs/setup.md section 4.
ADMIN_EMAIL=

# Razorpay payments (docs/setup.md section 5). Use TEST keys (rzp_test_...) until you go live.
# Razorpay → Account & Settings → API Keys. Without them, checkout offers WhatsApp instead.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay → Account & Settings → Webhooks: the secret you type when adding the webhook.
RAZORPAY_WEBHOOK_SECRET=
# Leave empty. Only automated tests point this at a pretend Razorpay.
RAZORPAY_API_BASE=

# --- Added in later phases ---

# Order emails through Resend (docs/setup.md section 6). Optional: without a key the store
# works, it just doesn't send emails. Free tier: 3,000 emails a month.
RESEND_API_KEY=
# Who emails come from. Until you verify a domain in Resend, leave this empty
# (uses onboarding@resend.dev, which can only email your own Resend login address).
EMAIL_FROM=
# Optional: where customer replies go, e.g. your Gmail.
EMAIL_REPLY_TO=
# Leave empty. Only automated tests point this at a pretend Resend.
RESEND_API_BASE=

# --- Browser tests only (npm run test:e2e, see tests/e2e/README.md). Leave empty otherwise. ---
# Where the shop runs during the tests (default http://localhost:3000).
E2E_BASE_URL=
# Use a Chrome/Chromium already on this computer instead of `npx playwright install`.
E2E_CHROMIUM_PATH=
